<tool id="ketos_train" name="Ketos Train" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>train or fine-tune recognition models</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <expand macro="creators"/>
    <command detect_errors="exit_code"><![CDATA[
        KETOS_DEVICE="\${KETOS_DEVICE:-cpu}" &&
        KETOS_WORKERS="\${KETOS_WORKERS:-1}" &&
        KETOS_THREADS="\${KETOS_THREADS:-1}" &&

        mkdir -p model logs &&
        
        ketos_exit_code=0 &&
        
        ketos
            #if str($global_opts.config).strip() and str($global_opts.config) != 'None'
                --config '$global_opts.config'
            #end if
            --device "\$KETOS_DEVICE"
            --workers "\$KETOS_WORKERS"
            --threads "\$KETOS_THREADS"
            #if str($global_opts.precision.dtype) in ('16', 'bf16'):
                --precision '${global_opts.precision.dtype}-${global_opts.precision.mode}'
            #elif str($global_opts.precision.dtype) in ('32', '64'):
                --precision '${global_opts.precision.dtype}-true'
            #else:
                --precision '${global_opts.precision.dtype}'
            #end if

            $global_opts.deterministic.mode
            #if $global_opts.deterministic.mode == '--deterministic'
                --seed '$global_opts.deterministic.seed'
            #end if
            train
            @RECOGNITION_TRAINING_ARGS@
            #if str($training_data.format_type).strip() and str($training_data.format_type) != 'None'
                --format-type '$training_data.format_type'
            #end if
            #if $validation.validation_source == "training_data_split"
                --partition '$validation.partition'
            #else
                --evaluation-data '$evaluation_manifest'
            #end if
            #if str($train_opts.pad).strip() and str($train_opts.pad) != 'None'
                --pad '$train_opts.pad'
            #end if
            #if str($train_opts.normalization).strip() and str($train_opts.normalization) != 'None'
                --normalization '$train_opts.normalization'
            #end if
            #if str($train_opts.normalize_whitespace).strip() and str($train_opts.normalize_whitespace) != 'None'
                $train_opts.normalize_whitespace
            #end if
            #if $train_opts.bidi_settings.reorder == 'yes'
                --reorder
                --base-dir '$train_opts.bidi_settings.base_dir'
            #else
                --no-reorder
            #end if
            #if $train_opts.legacy_polygons
                --legacy-polygons
            #end if
            @GROUND_TRUTH_ARGS@
            > training_report.txt 2>&1 || ketos_exit_code=\$?;

        cat training_report.txt;
        [ "\$ketos_exit_code" -eq 0 ] || exit "\$ketos_exit_code";
        
        @CAPTURE_TRAINING_OUTPUTS@
    ]]></command>
    <expand macro="env_vars"/>
    <configfiles>
        <configfile name="evaluation_manifest"><![CDATA[
            #if $validation.validation_source == "explicit"
            #for $dataset in $validation.evaluation_data
            ${dataset}
            #end for
            #end if
            ]]>
        </configfile>
    </configfiles>
    <inputs>
        <conditional name="training_data">
            <param argument="--format-type" type="select" label="Training data format">
                <option value="binary" selected="true">Compiled binary dataset</option>
                <option value="alto" selected="true">ALTO</option>
                <option value="page">PAGE XML</option>
                <option value="xml">XML</option>
                <option value="path">Line image/transcription pairs</option>
            </param>
            <when value="binary">
                <param name="ground_truth" type="data" multiple="true" format="arrow" label="Ground-truth data"/>
            </when>
            <expand macro="compile_training_data_input" format_type="alto" pair_label="page image/ALTO" annotation_format="alto" annotation_label="ALTO annotation"/>
            <expand macro="compile_training_data_input" format_type="page" pair_label="page image/PAGE XML" annotation_format="page.xml" annotation_label="PAGE XML annotation"/>
            <expand macro="compile_training_data_input" format_type="xml" pair_label="page image/XML" annotation_format="xml" annotation_label="XML annotation"/>
            <expand macro="compile_training_data_input" format_type="path" pair_label="line image/transcription" annotation_format="txt" annotation_label="Ground-truth transcription"/>
        </conditional>
        <expand macro="ketos_training_options"/>
        <expand macro="training_inputs"/>
        <conditional name="validation">
            <param name="validation_source" type="select" label="Validation data source">
                <option value="training_data_split" selected="true">
                    Data split from training data
                </option>
                <option value="explicit">
                    Explicit validation data
                </option>
            </param>
            <when value="training_data_split">
                <param name="partition" type="float" value="0.9" min="0" max="1" label="Training data fraction" help="Fraction of the provided ground-truth samples used for training. The remaining samples are used for validation."/>
            </when>
            <when value="explicit">
                <expand macro="evaluation_data"/>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <expand macro="training_outputs"/>
    </outputs>
    <tests>
        <!-- Train a small recognition model for one epoch. -->
        <test expect_num_outputs="3">
            <conditional name="training_data">
                <param name="format_type" value="binary"/>
                <param name="ground_truth" value="ketos_train_recognition.arrow" ftype="arrow"/>
            </conditional>
            <section name="train_opts">
                <conditional name="initialization">
                    <param name="source" value="new"/>
                </conditional>
                <conditional name="arch">
                    <param name="recognition_arch" value="ppocrv6"/>
                    <param name="batch_size" value="1"/>
                    <conditional name="ppocrv6_variant">
                        <param name="variant" value="tiny"/>
                    </conditional>
                    <conditional name="stop_condition">
                        <param name="quit" value="fixed"/>
                        <param name="epochs" value="1"/>
                    </conditional>
                </conditional>
                <param name="freq" value="1"/>
                <param name="augment" value="--no-augment"/>
            </section>
            <conditional name="validation">
                <param name="validation_source" value="training_data_split"/>
                <param name="partition" value="0.75"/>
            </conditional>
            <assert_command>
                <has_text text="--batch-size '1'"/>
                <has_text text="--variant 'tiny'"/>
                <has_text text="--epochs '1'"/>
            </assert_command>
            <output name="best_model" ftype="binary">
                <assert_contents>
                    <has_size min="10000"/>
                </assert_contents>
            </output>
            <output name="report" ftype="txt">
                <assert_contents>
                    <has_text text="Initializing new model."/>
                    <has_text text="Converting best model"/>
                </assert_contents>
            </output>
            <output_collection name="checkpoints" type="list" count="1"/>
        </test>
        <!-- Fine-tune existing weights and exercise recognition options. -->
        <test expect_num_outputs="3">
            <conditional name="training_data">
                <param name="format_type" value="binary"/>
                <param name="ground_truth" value="ketos_train_recognition.arrow" ftype="arrow"/>
            </conditional>
            <section name="train_opts">
                <conditional name="initialization">
                    <param name="source" value="load"/>
                    <param name="model" value="ketos_train_model.safetensors" ftype="safetensors"/>
                    <conditional name="resize_settings">
                        <param name="resize" value="union"/>
                    </conditional>
                </conditional>
                <conditional name="arch">
                    <param name="recognition_arch" value="infer"/>
                    <conditional name="stop_condition">
                        <param name="quit" value="fixed"/>
                        <param name="epochs" value="1"/>
                    </conditional>
                </conditional>
                <param name="freq" value="1"/>
                <param name="augment" value="--no-augment"/>
                <param name="normalization" value="NFKC"/>
                <param name="normalize_whitespace" value="false"/>
                <conditional name="bidi_settings">
                    <param name="reorder" value="yes"/>
                    <param name="base_dir" value="R"/>
                </conditional>
            </section>
            <conditional name="validation">
                <param name="validation_source" value="training_data_split"/>
                <param name="partition" value="0.75"/>
            </conditional>
            <output name="best_model" ftype="binary">
                <assert_contents>
                    <has_size min="10000"/>
                </assert_contents>
            </output>
            <output name="report" ftype="txt">
                <assert_contents>
                    <has_text text="Loading from checkpoint"/>
                    <has_text text="Converting best model"/>
                </assert_contents>
            </output>
            <output_collection name="checkpoints" type="list" count="1"/>
        </test>
    </tests>
    <help format="markdown">
Trains a Kraken recognition model from line-image or XML/ALTO/PageXML training data. Ketos writes checkpoints during training and converts the best checkpoint to a weights file at the end.
    </help>
    <expand macro="citations"/>
</tool>
