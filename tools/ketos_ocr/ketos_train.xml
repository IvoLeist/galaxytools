            </conditional>
        </expand>
        <expand macro="train_nonbinary_test" format_type="path">
            <conditional name="input_source">
                <param name="source" value="repeat"/>
                <repeat name="ground_truth_pairs">
                    <param name="image" value="compile_input_line.png" ftype="png"/>
                    <param name="annotation" value="compile_input_line.gt.txt" ftype="txt"/>
                </repeat>
                <repeat name="ground_truth_pairs">
                    <param name="image" value="compile_input_line.png" ftype="png"/>
                    <param name="annotation" value="compile_input_line.gt.txt" ftype="txt"/>
                </repeat>
                <repeat name="ground_truth_pairs">
                    <param name="image" value="compile_input_line.png" ftype="png"/>
                    <param name="annotation" value="compile_input_line.gt.txt" ftype="txt"/>
                </repeat>
                <repeat name="ground_truth_pairs">
                    <param name="image" value="compile_input_line.png" ftype="png"/>
                    <param name="annotation" value="compile_input_line.gt.txt" ftype="txt"/>
                </repeat>
            </conditional>
        </expand>
        <expand macro="train_nonbinary_test" format_type="path">
            <conditional name="input_source">
                <param name="source" value="collection"/>
                <param name="ground_truth_collection">
                    <collection type="list:paired">
                        <element name="pair_001">
                            <collection type="paired">
                                <element name="forward" value="compile_input_line.png" ftype="png"/>
                                <element name="reverse" value="compile_input_line.gt.txt" ftype="txt"/>
                            </collection>
                        </element>
                        <element name="pair_002">
                            <collection type="paired">
                                <element name="forward" value="compile_input_line.png" ftype="png"/>
                                <element name="reverse" value="compile_input_line.gt.txt" ftype="txt"/>
                            </collection>
                        </element>
                        <element name="pair_003">
                            <collection type="paired">
                                <element name="forward" value="compile_input_line.png" ftype="png"/>
                                <element name="reverse" value="compile_input_line.gt.txt" ftype="txt"/>
                            </collection>
                        </element>
                        <element name="pair_004">
                            <collection type="paired">
                                <element name="forward" value="compile_input_line.png" ftype="png"/>
                                <element name="reverse" value="compile_input_line.gt.txt" ftype="txt"/>
                            </collection>
                        </element>
                    </collection>
                </param>
            </conditional>
        </expand>
        <!-- Explicit validation from 1 Arrow dataset(s). -->
        <test expect_num_outputs="3">
            <conditional name="training_data">
                <param name="format_type" value="binary" />
                <param name="ground_truth" value="ketos_train_recognition.arrow" ftype="arrow" />
            </conditional>
            <section name="train_opts">
                <conditional name="initialization">
                    <param name="source" value="new" />
                </conditional>
                <conditional name="arch">
                    <param name="recognition_arch" value="vgsl" />
                    <param name="vgsl_spec" value="[1,12,0,1 Cr3,3,8 S1(1x0)1,3]" />
                    <conditional name="stop_condition">
                        <param name="quit" value="fixed" />
                        <param name="epochs" value="1" />
                    </conditional>
                </conditional>
                <param name="freq" value="1" />
                <param name="augment" value="--no-augment" />
                <param name="normalization" value="NFKC" />
