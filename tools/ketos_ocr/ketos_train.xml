<tool id="ketos_train" name="Ketos Train" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>train or fine-tune recognition models</description>
    <macros>
        <import>macros.xml</import>
        <import>macros_for_testing.xml</import>
    </macros>
    <expand macro="requirements"/>
    <expand macro="creators"/>
    <command detect_errors="exit_code"><![CDATA[
        KETOS_DEVICE="\${KETOS_DEVICE:-cpu}" &&
        KETOS_WORKERS="\${KETOS_WORKERS:-1}" &&
        KETOS_THREADS="\${KETOS_THREADS:-1}" &&

        #if $training_data.format_type != 'binary'
            #set $input_source = $training_data.input_source

            #if $input_source.source == 'repeat'
                #set $pairs = $input_source.ground_truth_pairs
            #else
                #set $pairs = $input_source.ground_truth_collection
            #end if

            #for $i, $pair in enumerate($pairs)
                #if $input_source.source == 'repeat'
                    #set $image = $pair.image
                    #set $annotation = $pair.annotation
                #else
                    #set $image = $pair.forward
                    #set $annotation = $pair.reverse
                #end if

                @REJECT_MULTIPAGE_TIFF_BASED_ON_FILE_METADATA@

                #if $training_data.format_type == 'path'
                    ln -s '$image' 'ground_truth_${i}.${image.ext}' &&
                    ln -s '$annotation' 'ground_truth_${i}.gt.txt' &&
                #else
                    mkdir -p 'ground_truth_${i}' &&
                    ln -s '$image' 'ground_truth_${i}/input.${image.ext}' &&
                    ln -s '$annotation' 'ground_truth_${i}/annotation.xml' &&
                #end if
            #end for
        #end if

        mkdir -p model logs &&
        
        ketos_exit_code=0 &&
        
        ketos
            #if str($global_opts.config).strip() and str($global_opts.config) != 'None'
                --config '$global_opts.config'
            #end if
            --device "\$KETOS_DEVICE"
            --workers "\$KETOS_WORKERS"
            --threads "\$KETOS_THREADS"
            #if str($global_opts.precision.dtype) in ('16', 'bf16'):
                --precision '${global_opts.precision.dtype}-${global_opts.precision.mode}'
            #elif str($global_opts.precision.dtype) in ('32', '64'):
                --precision '${global_opts.precision.dtype}-true'
            #else:
                --precision '${global_opts.precision.dtype}'
            #end if

            $global_opts.deterministic.mode
            #if $global_opts.deterministic.mode == '--deterministic'
                --seed '$global_opts.deterministic.seed'
            #end if
            train
            @RECOGNITION_TRAINING_ARGS@
            #if str($training_data.format_type).strip() and str($training_data.format_type) != 'None'
                --format-type '$training_data.format_type'
            #end if
            #if $validation.validation_source == "training_data_split"
                --partition '$validation.partition'
            #else
                --evaluation-data '$evaluation_manifest'
            #end if
            #if str($train_opts.pad).strip() and str($train_opts.pad) != 'None'
                --pad '$train_opts.pad'
            #end if
            #if str($train_opts.normalization).strip() and str($train_opts.normalization) != 'None'
                --normalization '$train_opts.normalization'
            #end if
            #if str($train_opts.normalize_whitespace).strip() and str($train_opts.normalize_whitespace) != 'None'
                $train_opts.normalize_whitespace
            #end if
            #if $train_opts.bidi_settings.reorder == 'yes'
                --reorder
                --base-dir '$train_opts.bidi_settings.base_dir'
            #else
                --no-reorder
            #end if
            #if $train_opts.legacy_polygons
                --legacy-polygons
            #end if
            #if $training_data.format_type == 'binary'
                @GROUND_TRUTH_ARGS@
            #else
                #for $i, $pair in enumerate($pairs)
                    #if $training_data.format_type == 'path'
                        #if $input_source.source == 'repeat'
                            #set $image = $pair.image
                        #else
                            #set $image = $pair.forward
                        #end if
                        'ground_truth_${i}.${image.ext}'
                    #else
                        'ground_truth_${i}/annotation.xml'
                    #end if
                #end for
            #end if
            > training_report.txt 2>&1 || ketos_exit_code=\$?;

        cat training_report.txt;
        [ "\$ketos_exit_code" -eq 0 ] || exit "\$ketos_exit_code";
        
        @CAPTURE_TRAINING_OUTPUTS@
    ]]></command>
    <expand macro="env_vars"/>
    <configfiles>
        <configfile name="evaluation_manifest"><![CDATA[
            #if $validation.validation_source == "explicit"
            #for $dataset in $validation.evaluation_data
            ${dataset}
            #end for
            #end if
            ]]>
        </configfile>
    </configfiles>
    <inputs>
        <conditional name="training_data">
            <param argument="--format-type" type="select" label="Training data format">
                <option value="binary" selected="true">Compiled binary dataset</option>
                <option value="alto" selected="true">ALTO</option>
                <option value="page">PAGE XML</option>
                <option value="xml">XML</option>
                <option value="path">Line image/transcription pairs</option>
            </param>
            <when value="binary">
                <param name="ground_truth" type="data" multiple="true" format="arrow" label="Ground-truth data"/>
            </when>
            <expand macro="compile_training_data_input" format_type="alto" pair_label="page image/ALTO" annotation_format="alto" annotation_label="ALTO annotation"/>
            <expand macro="compile_training_data_input" format_type="page" pair_label="page image/PAGE XML" annotation_format="page.xml" annotation_label="PAGE XML annotation"/>
            <expand macro="compile_training_data_input" format_type="xml" pair_label="page image/XML" annotation_format="xml" annotation_label="XML annotation"/>
            <expand macro="compile_training_data_input" format_type="path" pair_label="line image/transcription" annotation_format="txt" annotation_label="Ground-truth transcription"/>
        </conditional>
        <expand macro="ketos_training_options"/>
        <expand macro="training_inputs"/>
        <conditional name="validation">
            <param name="validation_source" type="select" label="Validation data source">
                <option value="training_data_split" selected="true">
                    Data split from training data
                </option>
                <option value="explicit">
                    Explicit validation data
                </option>
            </param>
            <when value="training_data_split">
                <param name="partition" type="float" value="0.9" min="0" max="1" label="Training data fraction" help="Fraction of the provided ground-truth samples used for training. The remaining samples are used for validation."/>
            </when>
            <when value="explicit">
                <param name="evaluation_data" type="data" multiple="true" format="arrow,xml" label="Evaluation data files" help="Ground-truth files used for validation. Use Arrow datasets with binary training data."/>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <expand macro="training_outputs"/>
    </outputs>
    <tests>
        <!-- Train a small recognition model for one epoch. -->
        <test expect_num_outputs="3">
            <conditional name="training_data">
                <param name="format_type" value="binary"/>
                <param name="ground_truth" value="ketos_train_recognition.arrow" ftype="arrow"/>
            </conditional>
            <section name="train_opts">
                <conditional name="initialization">
                    <param name="source" value="new"/>
                </conditional>
                <conditional name="arch">
                    <param name="recognition_arch" value="ppocrv6"/>
                    <param name="batch_size" value="1"/>
                    <conditional name="ppocrv6_variant">
                        <param name="variant" value="tiny"/>
                    </conditional>
                    <conditional name="stop_condition">
                        <param name="quit" value="fixed"/>
                        <param name="epochs" value="1"/>
                    </conditional>
                </conditional>
                <param name="freq" value="1"/>
                <param name="augment" value="--no-augment"/>
            </section>
            <conditional name="validation">
                <param name="validation_source" value="training_data_split"/>
                <param name="partition" value="0.75"/>
            </conditional>
            <assert_command>
                <has_text text="--batch-size '1'"/>
                <has_text text="--variant 'tiny'"/>
                <has_text text="--epochs '1'"/>
            </assert_command>
            <output name="best_model" ftype="binary">
                <assert_contents>
                    <has_size min="10000"/>
                </assert_contents>
            </output>
            <output name="report" ftype="txt">
                <assert_contents>
                    <has_text text="Initializing new model."/>
                    <has_text text="Converting best model"/>
                </assert_contents>
            </output>
            <output_collection name="checkpoints" type="list" count="1"/>
        </test>
        <!-- Fine-tune existing weights and exercise recognition options. -->
        <test expect_num_outputs="3">
            <conditional name="training_data">
                <param name="format_type" value="binary"/>
                <param name="ground_truth" value="ketos_train_recognition.arrow" ftype="arrow"/>
            </conditional>
            <section name="train_opts">
                <conditional name="initialization">
                    <param name="source" value="load"/>
                    <param name="model" value="ketos_train_model.safetensors" ftype="safetensors"/>
                    <conditional name="resize_settings">
                        <param name="resize" value="union"/>
                    </conditional>
                </conditional>
                <conditional name="arch">
                    <param name="recognition_arch" value="infer"/>
                    <conditional name="stop_condition">
                        <param name="quit" value="fixed"/>
                        <param name="epochs" value="1"/>
                    </conditional>
                </conditional>
                <param name="freq" value="1"/>
                <param name="augment" value="--no-augment"/>
                <param name="normalization" value="NFKC"/>
                <param name="normalize_whitespace" value="false"/>
                <conditional name="bidi_settings">
                    <param name="reorder" value="yes"/>
                    <param name="base_dir" value="R"/>
                </conditional>
            </section>
            <conditional name="validation">
                <param name="validation_source" value="training_data_split"/>
                <param name="partition" value="0.75"/>
            </conditional>
            <output name="best_model" ftype="binary">
                <assert_contents>
                    <has_size min="10000"/>
                </assert_contents>
            </output>
            <output name="report" ftype="txt">
                <assert_contents>
                    <has_text text="Loading from checkpoint"/>
                    <has_text text="Converting best model"/>
                </assert_contents>
            </output>
            <output_collection name="checkpoints" type="list" count="1"/>
        </test>
        <!-- Resume epoch 0 into epoch 1 using the checkpoint's staged input paths. -->
        <test expect_num_outputs="3">
            <conditional name="training_data">
                <param name="format_type" value="path"/>
                <conditional name="input_source">
                    <param name="source" value="repeat"/>
                    <repeat name="ground_truth_pairs">
                        <param name="image" value="compile_input_line.png" ftype="png"/>
                        <param name="annotation" value="compile_input_line.gt.txt" ftype="txt"/>
                    </repeat>
                    <repeat name="ground_truth_pairs">
                        <param name="image" value="compile_input_line.png" ftype="png"/>
                        <param name="annotation" value="compile_input_line.gt.txt" ftype="txt"/>
                    </repeat>
                    <repeat name="ground_truth_pairs">
                        <param name="image" value="compile_input_line.png" ftype="png"/>
                        <param name="annotation" value="compile_input_line.gt.txt" ftype="txt"/>
                    </repeat>
                    <repeat name="ground_truth_pairs">
                        <param name="image" value="compile_input_line.png" ftype="png"/>
                        <param name="annotation" value="compile_input_line.gt.txt" ftype="txt"/>
                    </repeat>
                </conditional>
            </conditional>
            <section name="train_opts">
                <conditional name="initialization">
                    <param name="source" value="resume"/>
                    <!-- PyTorch checkpoints are ZIP containers; preserve them on upload. -->
                    <param name="checkpoint" value="ketos_train_resume.ckpt" ftype="zip"/>
                </conditional>
                <conditional name="arch">
                    <param name="recognition_arch" value="infer"/>
                    <conditional name="stop_condition">
                        <param name="quit" value="fixed"/>
                        <param name="epochs" value="2"/>
                    </conditional>
                </conditional>
                <param name="freq" value="1"/>
                <param name="augment" value="--no-augment"/>
            </section>
            <conditional name="validation">
                <param name="validation_source" value="training_data_split"/>
                <param name="partition" value="0.75"/>
            </conditional>
            <assert_command>
                <has_text text="--resume '"/>
                <has_text text="--epochs '2'"/>
                <not_has_text text="--load"/>
                <not_has_text text="--resize"/>
            </assert_command>
            <output name="best_model" ftype="binary">
                <assert_contents>
                    <has_size min="10000"/>
                </assert_contents>
            </output>
            <output name="report" ftype="txt">
                <assert_contents>
                    <has_text text="Resuming from checkpoint"/>
                    <has_text text="Restored all states from the checkpoint"/>
                    <has_text text="max_epochs=2"/>
                    <has_text text="Converting best model"/>
                    <has_text text="checkpoint_01-"/>
                    <not_has_text text="Initializing new model."/>
                </assert_contents>
            </output>
            <output_collection name="checkpoints" type="list" count="1"/>
        </test>
        <!-- Train a new compact VGSL model for one epoch. -->
        <test expect_num_outputs="3">
            <conditional name="training_data">
                <param name="format_type" value="binary"/>
                <param name="ground_truth" value="ketos_train_recognition.arrow" ftype="arrow"/>
            </conditional>
            <section name="train_opts">
                <conditional name="initialization">
                    <param name="source" value="new"/>
                </conditional>
                <conditional name="arch">
                    <param name="recognition_arch" value="vgsl"/>
                    <param name="vgsl_spec" value="[1,12,0,1 Cr3,3,8 S1(1x0)1,3]"/>
                    <conditional name="stop_condition">
                        <param name="quit" value="fixed"/>
                        <param name="epochs" value="1"/>
                    </conditional>
                </conditional>
                <param name="freq" value="1"/>
                <param name="augment" value="--no-augment"/>
                <param name="normalization" value="NFKC"/>
                <param name="normalize_whitespace" value="false"/>
                <conditional name="bidi_settings">
                    <param name="reorder" value="yes"/>
                    <param name="base_dir" value="R"/>
                </conditional>
            </section>
            <conditional name="validation">
                <param name="validation_source" value="training_data_split"/>
                <param name="partition" value="0.75"/>
            </conditional>
            <assert_command>
                <has_text text="--arch 'vgsl'"/>
                <has_text text="--spec '[1,12,0,1 Cr3,3,8 S1(1x0)1,3]'"/>
                <has_text text="--quit 'fixed'"/>
                <has_text text="--epochs '1'"/>
                <not_has_text text="--optimizer"/>
                <not_has_text text="--variant"/>
            </assert_command>
            <output name="best_model" ftype="binary">
                <assert_contents>
                    <has_size min="10000"/>
                </assert_contents>
            </output>
            <output name="report" ftype="txt">
                <assert_contents>
                    <has_text text="Initializing new model."/>
                    <has_text text="Converting best model"/>
                </assert_contents>
            </output>
            <output_collection name="checkpoints" type="list" count="1"/>
        </test>
        <!-- Replace the loaded codec and disable bidirectional reordering. -->
        <test expect_num_outputs="3">
            <conditional name="training_data">
                <param name="format_type" value="binary"/>
                <param name="ground_truth" value="ketos_train_recognition.arrow" ftype="arrow"/>
            </conditional>
            <section name="train_opts">
                <conditional name="initialization">
                    <param name="source" value="load"/>
                    <param name="model" value="ketos_train_model.safetensors" ftype="safetensors"/>
                    <conditional name="resize_settings">
                        <param name="resize" value="new"/>
                    </conditional>
                </conditional>
                <conditional name="arch">
                    <param name="recognition_arch" value="infer"/>
                    <conditional name="stop_condition">
                        <param name="quit" value="fixed"/>
                        <param name="epochs" value="1"/>
                    </conditional>
                </conditional>
                <param name="freq" value="1"/>
                <param name="augment" value="--no-augment"/>
                <param name="normalization" value="NFKC"/>
                <param name="normalize_whitespace" value="false"/>
                <conditional name="bidi_settings">
                    <param name="reorder" value="no"/>
                </conditional>
            </section>
            <conditional name="validation">
                <param name="validation_source" value="training_data_split"/>
                <param name="partition" value="0.75"/>
            </conditional>
            <assert_command>
                <has_text text="--resize 'new'"/>
                <has_text text="--normalization 'NFKC'"/>
                <has_text text="--no-normalize-whitespace"/>
                <has_text text="--no-reorder"/>
                <not_has_text text="--base-dir"/>
                <not_has_text text="--spec"/>
            </assert_command>
            <output name="best_model" ftype="binary">
                <assert_contents>
                    <has_size min="10000"/>
                </assert_contents>
            </output>
            <output name="report" ftype="txt">
                <assert_contents>
                    <has_text text="Loading from checkpoint"/>
                    <has_text text="Converting best model"/>
                </assert_contents>
            </output>
            <output_collection name="checkpoints" type="list" count="1"/>
        </test>
        <!-- Direct non-binary training: each format with repeats and list:paired input.
             Four line pairs ensure both training and validation have samples.
             These success tests also guard the input staging/argument wiring. -->
        <expand macro="train_nonbinary_test" format_type="alto">
            <conditional name="input_source">
                <param name="source" value="repeat"/>
                <repeat name="ground_truth_pairs">
                    <param name="image" value="input_binarized.png" ftype="png"/>
                    <param name="annotation" value="input_binarized_ocr_output.alto" ftype="alto"/>
                </repeat>
                <repeat name="ground_truth_pairs">
                    <param name="image" value="input_binarized.png" ftype="png"/>
                    <param name="annotation" value="input_binarized_ocr_output.alto" ftype="alto"/>
                </repeat>
            </conditional>
        </expand>
        <expand macro="train_nonbinary_test" format_type="alto">
            <conditional name="input_source">
                <param name="source" value="collection"/>
                <param name="ground_truth_collection">
                    <collection type="list:paired">
                        <element name="pair_001">
                            <collection type="paired">
                                <element name="forward" value="input_binarized.png" ftype="png"/>
                                <element name="reverse" value="input_binarized_ocr_output.alto" ftype="alto"/>
                            </collection>
                        </element>
                        <element name="pair_002">
                            <collection type="paired">
                                <element name="forward" value="input_binarized.png" ftype="png"/>
                                <element name="reverse" value="input_binarized_ocr_output.alto" ftype="alto"/>
                            </collection>
                        </element>
                    </collection>
                </param>
            </conditional>
        </expand>
        <expand macro="train_nonbinary_test" format_type="page">
            <conditional name="input_source">
                <param name="source" value="repeat"/>
                <repeat name="ground_truth_pairs">
                    <param name="image" value="input_binarized.png" ftype="png"/>
                    <param name="annotation" value="input_binarized_ocr_output.page.xml" ftype="page.xml"/>
                </repeat>
                <repeat name="ground_truth_pairs">
                    <param name="image" value="input_binarized.png" ftype="png"/>
                    <param name="annotation" value="input_binarized_ocr_output.page.xml" ftype="page.xml"/>
                </repeat>
            </conditional>
        </expand>
        <expand macro="train_nonbinary_test" format_type="page">
            <conditional name="input_source">
                <param name="source" value="collection"/>
                <param name="ground_truth_collection">
                    <collection type="list:paired">
                        <element name="pair_001">
                            <collection type="paired">
                                <element name="forward" value="input_binarized.png" ftype="png"/>
                                <element name="reverse" value="input_binarized_ocr_output.page.xml" ftype="page.xml"/>
                            </collection>
                        </element>
                        <element name="pair_002">
                            <collection type="paired">
                                <element name="forward" value="input_binarized.png" ftype="png"/>
                                <element name="reverse" value="input_binarized_ocr_output.page.xml" ftype="page.xml"/>
                            </collection>
                        </element>
                    </collection>
                </param>
            </conditional>
        </expand>
        <expand macro="train_nonbinary_test" format_type="xml">
            <conditional name="input_source">
                <param name="source" value="repeat"/>
                <repeat name="ground_truth_pairs">
                    <param name="image" value="input_binarized.png" ftype="png"/>
                    <param name="annotation" value="input_binarized_ocr_output.page.xml" ftype="xml"/>
                </repeat>
                <repeat name="ground_truth_pairs">
                    <param name="image" value="input_binarized.png" ftype="png"/>
                    <param name="annotation" value="input_binarized_ocr_output.page.xml" ftype="xml"/>
                </repeat>
            </conditional>
        </expand>
        <expand macro="train_nonbinary_test" format_type="xml">
            <conditional name="input_source">
                <param name="source" value="collection"/>
                <param name="ground_truth_collection">
                    <collection type="list:paired">
                        <element name="pair_001">
                            <collection type="paired">
                                <element name="forward" value="input_binarized.png" ftype="png"/>
                                <element name="reverse" value="input_binarized_ocr_output.page.xml" ftype="xml"/>
                            </collection>
                        </element>
                        <element name="pair_002">
                            <collection type="paired">
                                <element name="forward" value="input_binarized.png" ftype="png"/>
                                <element name="reverse" value="input_binarized_ocr_output.page.xml" ftype="xml"/>
                            </collection>
                        </element>
                    </collection>
