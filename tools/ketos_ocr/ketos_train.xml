<tool id="ketos_train" name="Ketos Train" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>train or fine-tune recognition models</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <expand macro="creators"/>
    <command detect_errors="exit_code"><![CDATA[
        KETOS_DEVICE="\${KETOS_DEVICE:-cpu}" &&
        KETOS_WORKERS="\${KETOS_WORKERS:-1}" &&
        KETOS_THREADS="\${KETOS_THREADS:-1}" &&

        mkdir -p model logs &&
        ketos
            #if str($training_opts.config).strip() and str($training_opts.config) != 'None'
                --config '$training_opts.config'
            #end if
            --device "\$KETOS_DEVICE"
            --workers "\$KETOS_WORKERS"
            --threads "\$KETOS_THREADS"
            #if str($training_opts.precision).strip() and str($training_opts.precision) != 'None'
                --precision '$training_opts.precision'
            #end if

            #if str('$training_opts.deterministic') == 'deterministic'
                #if str($training_opts.seed).strip() and str($training_opts.seed) != 'None'
                    --seed '$training_opts.seed'
                #else
                    --seed 42
                #end if
            #end if
            train
            @TRAINING_ARGS@
            --format-type '$format_type'
            #if str($train_opts.arch.recognition_arch).strip() and str($train_opts.arch.recognition_arch) != 'None'
                --arch '$train_opts.arch.recognition_arch'
            #end if
            #if str('$train_opts.arch.recognition_arch') == 'ppocrv6_variant'
                --variant '$train_opts.ppocrv6_variant'
            #end if
            #if str('$train_opts.arch.recognition_arch') == 'vgsl_spec'
                --spec '$train_opts.vgsl_spec'
            #end if
            #if $validation.validation_source == "automatic"
                --partition '$validation.partition'
            #else
                --evaluation-data '$evaluation_manifest'
            #end if
            #if str($pad).strip() and str($pad) != 'None'
                --pad '$pad'
            #end if
            #if str($normalization).strip() and str($normalization) != 'None'
                --normalization '$normalization'
            #end if
            #if str($normalize_whitespace).strip() and str($normalize_whitespace) != 'None'
                $normalize_whitespace
            #end if
            #if str($codec).strip() and str($codec) != 'None'
                --codec '$codec'
            #end if
            #if str($resize).strip() and str($resize) != 'None'
                --resize '$resize'
            #end if
            #if str($freeze_backbone).strip() and str($freeze_backbone) != 'None'
                --freeze-backbone '$freeze_backbone'
            #end if
            #if str($reorder).strip() and str($reorder) != 'None'
                $reorder
                #if $reorder == '--reorder'
                    --base-dir '$base_dir'
                #end if
            #end if
            #if $legacy_polygons
                --legacy-polygons
            #end if
            @GROUND_TRUTH_ARGS@
            > training_report.txt 2>&1 || ketos_exit_code=\$?;

        cat training_report.txt;
        [ "\$ketos_exit_code" -eq 0 ] || exit "\$ketos_exit_code";
        
        @CAPTURE_TRAINING_OUTPUTS@
    ]]></command>
    <expand macro="env_vars"/>
    <configfiles>
        <configfile name="evaluation_manifest"><![CDATA[
            #if $validation.validation_source == "explicit"
            #for $dataset in $validation.evaluation_data
            ${dataset}
            #end for
            #end if
            ]]>
        </configfile>
    </configfiles>
    <inputs>
        <expand macro="ketos_training_options"/>
        <expand macro="ground_truth_data"/>
        <conditional name="validation">
            <param name="validation_source" type="select" label="Validation">
                <option value="automatic" selected="true">
                    Automatically split training data
                </option>
                <option value="explicit">
                    Use explicit validation data
                </option>
            </param>

            <when value="automatic">
                <param
                    name="partition"
                    type="float"
                    value="0.9"
                    min="0"
                    max="1"
                    label="Training data fraction"
                    help="Fraction of the provided ground-truth samples used for training. The remaining samples are used for validation."
                />
            </when>
            <when value="explicit">
                <expand macro="evaluation_data"/>
            </when>
        </conditional>
        <expand macro="training_inputs"/>
        <param argument="--format-type" type="select" label="Training data format">
            <option value="path" selected="true">Path/image pairs</option>
            <option value="xml">XML</option>
            <option value="alto">ALTO</option>
            <option value="page">PageXML</option>
            <option value="binary">Compiled binary dataset</option>
        </param>
        <param argument="--pad" type="integer" optional="true" min="0" label="Left/right padding around lines"/>
        <param argument="--normalization" type="select" optional="true" label="Ground-truth Unicode normalization">
            <option value="" selected="true">Use Ketos default</option>
            <option value="NFD">NFD</option>
            <option value="NFKD">NFKD</option>
            <option value="NFC">NFC</option>
            <option value="NFKC">NFKC</option>
        </param>
        <param name="normalize_whitespace" type="select" label="Normalize Unicode whitespace">
            <option value="" selected="true">Use Ketos default</option>
            <option value="--normalize-whitespace">Enable</option>
            <option value="--no-normalize-whitespace">Disable</option>
        </param>
        <param argument="--codec" type="data" format="json" optional="true" label="Codec JSON definition"/>
        <param argument="--resize" type="select" optional="true" label="Codec/output layer resizing">
            <option value="" selected="true">Use Ketos default</option>
            <option value="union">union</option>
            <option value="new">new</option>
            <option value="fail">fail</option>
            <option value="add">add (deprecated)</option>
            <option value="both">both (deprecated)</option>
        </param>
        <param argument="--freeze-backbone" type="integer" optional="true" min="0" label="Samples to keep the backbone frozen"/>
        <param name="reorder" type="select" label="Apply Unicode BiDi reordering">
            <option value="" selected="true">Use Ketos default</option>
            <option value="--reorder">Enable</option>
            <option value="--no-reorder">Disable</option>
        </param>
        <param argument="--base-dir" type="select" label="Base text direction for BiDi reordering">
            <option value="auto" selected="true">Auto</option>
            <option value="L">Left-to-right</option>
            <option value="R">Right-to-left</option>
        </param>
        <param argument="--legacy-polygons" type="boolean" truevalue="true" falsevalue="false" checked="false" label="Use legacy polygon extractor"/>
    </inputs>
    <outputs>
        <expand macro="training_outputs"/>
    </outputs>
    <tests>
        <!-- Train a small recognition model for one epoch. -->
        <test expect_num_outputs="3">
            <param name="ground_truth" value="ketos_train_recognition.arrow" ftype="binary"/>
            <section name="train_opts">
                <conditional name="initialization">
                    <param name="source" value="new"/>
                </conditional>
                <param name="batch_size" value="1"/>
                <param name="freq" value="1"/>
                <param name="quit" value="fixed"/>
                <param name="epochs" value="1"/>
                <param name="min_epochs" value="1"/>
                <param name="partition" value="0.75"/>
                <param name="augment" value="--no-augment"/>
            </section>
            <param name="format_type" value="binary"/>
            <assert_command>
                <has_text text="KETOS_DEVICE=&quot;${KETOS_DEVICE:-cpu}&quot;"/>
                <has_text text="KETOS_WORKERS=&quot;${KETOS_WORKERS:-1}&quot;"/>
                <has_text text="KETOS_THREADS=&quot;${KETOS_THREADS:-1}&quot;"/>
                <has_text text="train"/>
                <has_text text="--device &quot;$KETOS_DEVICE&quot;"/>
                <has_text text="--workers &quot;$KETOS_WORKERS&quot;"/>
                <has_text text="--threads &quot;$KETOS_THREADS&quot;"/>
                <has_text text="--batch-size '1'"/>
                <has_text text="--quit 'fixed'"/>
                <has_text text="--epochs '1'"/>
                <has_text text="--min-epochs '1'"/>
                <has_text text="--partition '0.75'"/>
                <has_text text="--no-augment"/>
                <has_text text="--format-type 'binary'"/>
            </assert_command>
            <output name="best_model" ftype="binary">
                <assert_contents>
                    <has_size min="10000"/>
                </assert_contents>
            </output>
            <output name="report" ftype="txt">
                <assert_contents>
                    <has_text text="Initializing new model."/>
                    <has_text text="Converting best model"/>
                </assert_contents>
            </output>
            <output_collection name="checkpoints" type="list" count="1"/>
        </test>
        <!-- Fine-tune existing weights and exercise recognition options. -->
        <test expect_num_outputs="3">
            <param name="ground_truth" value="ketos_train_recognition.arrow" ftype="binary"/>
            <section name="train_opts">
                <conditional name="initialization">
                    <param name="source" value="load"/>
                    <param name="model" value="ketos_train_model.safetensors" ftype="safetensors"/>
                </conditional>
                <param name="batch_size" value="32"/>
                <param name="freq" value="1.0"/>
                <param name="quit" value="fixed"/>
                <param name="epochs" value="1"/>
                <param name="min_epochs" value="1"/>
                <param name="partition" value="0.75"/>
                <param name="augment" value="--no-augment"/>
            </section>
            <param name="format_type" value="binary"/>
            <param name="normalization" value="NFKC"/>
            <param name="normalize_whitespace" value="--no-normalize-whitespace"/>
            <param name="resize" value="union"/>
            <param name="freeze_backbone" value="2"/>
            <param name="reorder" value="--reorder"/>
            <param name="base_dir" value="R"/>
            <assert_command>
                <has_text text="--load"/>
                <has_text text="--format-type 'binary'"/>
                <has_text text="--normalization 'NFKC'"/>
                <has_text text="--no-normalize-whitespace"/>
                <has_text text="--resize 'union'"/>
                <has_text text="--freeze-backbone '2'"/>
                <has_text text="--reorder"/>
                <has_text text="--base-dir 'R'"/>
            </assert_command>
            <output name="best_model" ftype="binary">
                <assert_contents>
                    <has_size min="10000"/>
                </assert_contents>
            </output>
            <output name="report" ftype="txt">
                <assert_contents>
                    <has_text text="Loading from checkpoint"/>
                    <has_text text="Converting best model"/>
                </assert_contents>
            </output>
            <output_collection name="checkpoints" type="list" count="1"/>
        </test>
    </tests>
    <help format="markdown">
Trains a Kraken recognition model from line-image or XML/ALTO/PageXML training data. Ketos writes checkpoints during training and converts the best checkpoint to a weights file at the end.
    </help>
    <expand macro="citations"/>
</tool>
