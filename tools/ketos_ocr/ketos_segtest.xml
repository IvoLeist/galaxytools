            </conditional>
            <conditional name="test_data">
                <param name="format_type" value="page"/>
                <conditional name="input_source">
                    <param name="source" value="repeat"/>
                    <repeat name="ground_truth_pairs">
                        <param name="image" value="input_binarized.png" ftype="png"/>
                        <param name="annotation" value="input_binarized_ocr_output.page.xml" ftype="page.xml"/>
                    </repeat>
                </conditional>
            </conditional>
            <assert_command>
                <has_text text="segtest"/>
                <has_text text="--format-type 'page'"/>
                <has_text text="--test-class-mapping-mode 'full'"/>
            </assert_command>
            <output name="report" ftype="txt">
                <assert_contents>
                    <has_text text="Class Mapping Diagnostics"/>
                    <has_text text="Pixel Accuracy"/>
                    <has_text text="IOU"/>
                    <has_text text="Object Count"/>
                    <has_text text="Precision"/>
                    <has_text text="Recall"/>
                    <has_text text="F1"/>
                    <has_text text="Overall"/>
