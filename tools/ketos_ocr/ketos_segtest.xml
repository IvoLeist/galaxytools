<tool id="ketos_segtest" name="Ketos Segtest" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>evaluate baseline and region segmentation against ground truth</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements">
        <requirement type="package" version="4.1.2">yq</requirement>
    </expand>
    <expand macro="creators"/>
    <command detect_errors="exit_code"><![CDATA[
        export TORCHDYNAMO_DISABLE="\${TORCHDYNAMO_DISABLE:-1}" &&
        export TORCHINDUCTOR_CACHE_DIR="\${TORCHINDUCTOR_CACHE_DIR:-\$_GALAXY_JOB_TMP_DIR}" &&
        KETOS_DEVICE="\${KETOS_DEVICE:-cpu}" &&
        KETOS_WORKERS="\${KETOS_WORKERS:-1}" &&
        KETOS_THREADS="\${KETOS_THREADS:-1}" &&

        #if $model_input.model_type == 'checkpoint'
            ln -s '$model_input.model' model.ckpt &&
            #set $model_path = 'model.ckpt'
        #else
            #set $model_path = str($model_input.model)
        #end if

        #set $stage_input_source = $test_data.input_source
        #set $stage_format = $test_data.format_type
        #set $stage_prefix = 'ground_truth'
        @STAGE_RECOGNITION_GROUND_TRUTH@

        python '$__tool_directory__/ketos_segtest.py'
            #if $options.class_mapping.mode == 'custom'
                --config '$class_mapping_config'
            #end if
            --device "\$KETOS_DEVICE"
            --workers "\$KETOS_WORKERS"
            --threads "\$KETOS_THREADS"
            segtest
            --model '$model_path'
            --format-type '$test_data.format_type'
            --test-class-mapping-mode '$options.class_mapping.mode'
            #if str($options.bl_tol) not in ('', 'None')
                --bl-tol '$options.bl_tol'
            #end if
            #for $path in $stage_paths
                '$path'
            #end for
            > '$report'
    ]]></command>
    <expand macro="env_vars"/>
    <configfiles>
        <configfile name="class_mapping_config"><![CDATA[#import json
#set $config = {}
#if $options.class_mapping.mode == 'custom'
#set $lines = [[str($entry.class_name), int($entry.label)] for $entry in $options.class_mapping.line_class_mapping]
#set $regions = [[str($entry.class_name), int($entry.label)] for $entry in $options.class_mapping.region_class_mapping]
#set $config = {'segtest': {'line_class_mapping': $lines, 'region_class_mapping': $regions}}
#end if
$json.dumps($config, ensure_ascii=True)
]]></configfile>
    </configfiles>
    <inputs>
        <conditional name="model_input">
            <param name="model_type" type="select" label="Model format">
                <option value="weights" selected="true">Model weights (Safetensors or CoreML)</option>
                <option value="checkpoint">Training checkpoint</option>
            </param>
            <when value="weights">
                <param name="model" type="data" format="binary,safetensors" label="Segmentation model"/>
            </when>
            <when value="checkpoint">
                <param name="model" type="data" format="binary" label="Segmentation checkpoint" help="Use a checkpoint produced by Ketos Segtrain. Upload checkpoints as binary data so Galaxy preserves the file intact."/>
            </when>
        </conditional>
        <conditional name="test_data">
            <param argument="--format-type" type="select" label="Test data format">
                <option value="page" selected="true">PAGE XML</option>
                <option value="alto">ALTO</option>
                <option value="xml">Automatically detect ALTO or PAGE XML (including mixed inputs)</option>
            </param>
            <when value="page">
                <expand macro="paired_ground_truth_input" pair_label="page image/annotation" annotation_format="page.xml" annotation_label="PAGE annotation"/>
            </when>
            <when value="alto">
                <expand macro="paired_ground_truth_input" pair_label="page image/annotation" annotation_format="alto" annotation_label="ALTO annotation"/>
            </when>
            <when value="xml">
                <expand macro="paired_ground_truth_input" pair_label="page image/annotation" annotation_format="xml" annotation_label="ALTO or PAGE annotation"/>
            </when>
        </conditional>
        <section name="options" title="Evaluation options" expanded="false">
            <param argument="--bl-tol" type="float" min="0" optional="true" label="Baseline detection tolerance" help="Tolerance in pixels for matching detected baselines. Leave empty to use Kraken's default (10 pixels).">
                <validator type="in_range" min="0" exclude_min="true"/>
            </param>
            <conditional name="class_mapping">
                <param name="mode" type="select" label="Baseline and region class mappings" help="Use the checkpoint mapping, canonical model classes, or explicit mappings matching the model output labels.">
                    <option value="full" selected="true">Full checkpoint mapping (canonical for weights)</option>
                    <option value="canonical">Canonical model mapping</option>
                    <option value="custom">Set class labels explicitly</option>
                </param>
                <when value="full"/>
                <when value="canonical"/>
                <when value="custom">
                    <repeat name="line_class_mapping" title="Baseline class mapping" min="0" help="Map annotation line types to output labels. Leave empty to disable baseline evaluation. Reuse a label to merge line types; use * as the fallback for unlisted types.">
                        <param name="class_name" type="text" label="Baseline class name">
                            <validator type="empty_field"/>
                            <sanitizer sanitize="false"/>
                        </param>
                        <param name="label" type="integer" min="2" value="2" label="Output label" help="Labels 0 and 1 are reserved. Baseline labels must not overlap region labels."/>
                    </repeat>
                    <repeat name="region_class_mapping" title="Region class mapping" min="0" help="Map annotation region types to output labels. Leave empty to disable region evaluation. Reuse a label to merge region types; use * as the fallback for unlisted types. Unlisted types are ignored without a fallback.">
                        <param name="class_name" type="text" label="Region class name">
                            <validator type="empty_field"/>
                            <sanitizer sanitize="false"/>
                        </param>
                        <param name="label" type="integer" min="2" value="3" label="Output label" help="Labels 0 and 1 are reserved. Region labels must not overlap baseline labels."/>
                    </repeat>
                </when>
            </conditional>
        </section>
    </inputs>
    <outputs>
        <data name="report" format="txt" label="${tool.name} on ${on_string}: segmentation accuracy"/>
    </outputs>
