            <conditional name="test_data">
                <param name="format_type" value="binary"/>
                <param name="ground_truth" value="ketos_train_recognition.arrow" ftype="arrow"/>
            </conditional>
            <output name="report">
                <assert_contents>
                    <has_text text="Characters"/>
                    <has_text text="Character Accuracy"/>
                    <has_text text="Word Accuracy"/>
                    <has_text text="Insertions"/>
                    <has_text text="Deletions"/>
                    <has_text text="Substitutions"/>
