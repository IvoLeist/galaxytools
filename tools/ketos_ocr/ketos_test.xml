<tool id="ketos_test" name="Ketos Test" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>evaluate OCR recognition accuracy against ground truth</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements">
        <requirement type="package" version="4.1.2">yq</requirement>
    </expand>
    <expand macro="creators"/>
    <command detect_errors="exit_code"><![CDATA[
        export TORCHDYNAMO_DISABLE="\${TORCHDYNAMO_DISABLE:-1}" &&
        export TORCHINDUCTOR_CACHE_DIR="\${TORCHINDUCTOR_CACHE_DIR:-\$_GALAXY_JOB_TMP_DIR}" &&
        KETOS_DEVICE="\${KETOS_DEVICE:-cpu}" &&
        KETOS_WORKERS="\${KETOS_WORKERS:-1}" &&
        KETOS_THREADS="\${KETOS_THREADS:-1}" &&

        #if $model_input.model_type == 'checkpoint'
            ln -s '$model_input.model' model.ckpt &&
            #set $model_path = 'model.ckpt'
        #else
            #set $model_path = str($model_input.model)
        #end if

        #if $test_data.format_type != 'binary'
            #set $stage_input_source = $test_data.input_source
            #set $stage_format = $test_data.format_type
            #set $stage_prefix = 'ground_truth'
            @STAGE_RECOGNITION_GROUND_TRUTH@
            #set $ground_truth_paths = $stage_paths

        #end if

        ketos
            --device "\$KETOS_DEVICE"
            --workers "\$KETOS_WORKERS"
            --threads "\$KETOS_THREADS"
            test
            --model '$model_path'
            --format-type '$test_data.format_type'
            #if $options.arch != 'auto'
                --arch '$options.arch'
            #end if
            #if str($options.batch_size) not in ('', 'None')
                --batch-size '$options.batch_size'
            #end if
            #if str($options.pad) not in ('', 'None')
                --pad '$options.pad'
            #end if
            #if $options.linetype != 'auto'
                --linetype '$options.linetype'
            #end if
            #if $options.normalization != 'None'
                --normalization '$options.normalization'
            #end if
            #if $options.normalize_whitespace != 'auto'
                $options.normalize_whitespace
            #end if
            #if $options.bidi.reorder == 'yes'
                --reorder --base-dir '$options.bidi.base_dir'
            #elif $options.bidi.reorder == 'no'
                --no-reorder
            #end if
            $options.no_legacy_polygons
            #if $test_data.format_type == 'binary'
                #for $dataset in $test_data.ground_truth
                    '$dataset'
                #end for
            #else
                #for $path in $ground_truth_paths
                    '$path'
                #end for
            #end if
            > '$report'
    ]]></command>
    <expand macro="env_vars"/>
    <inputs>
        <conditional name="model_input">
            <param name="model_type" type="select" label="Model format">
                <option value="weights" selected="true">Model weights (Safetensors or CoreML)</option>
                <option value="checkpoint">Training checkpoint</option>
            </param>
            <when value="weights">
                <param name="model" type="data" format="binary,safetensors" label="Recognition model"/>
            </when>
            <when value="checkpoint">
                <param name="model" type="data" format="binary" label="Recognition checkpoint" help="Use a checkpoint produced by Ketos Train. Upload checkpoints as binary data so Galaxy preserves the file intact."/>
            </when>
        </conditional>
        <conditional name="test_data">
            <param name="format_type" type="select" label="Test data format">
                <option value="binary" selected="true">Compiled Arrow datasets</option>
                <option value="path">Line image/transcription pairs</option>
                <option value="alto">ALTO</option>
                <option value="page">PAGE XML</option>
            </param>
            <when value="binary">
                <param name="ground_truth" type="data" format="arrow" multiple="true" label="Test datasets"/>
            </when>
            <when value="path">
                <expand macro="paired_ground_truth_input" pair_label="line image/transcription" annotation_format="txt" annotation_label="Ground-truth transcription"/>
            </when>
            <when value="alto">
                <expand macro="paired_ground_truth_input" pair_label="page image/ALTO" annotation_format="alto" annotation_label="ALTO annotation"/>
            </when>
            <when value="page">
                <expand macro="paired_ground_truth_input" pair_label="page image/PAGE" annotation_format="page.xml" annotation_label="PAGE annotation"/>
            </when>
        </conditional>
        <section name="options" title="Evaluation options" expanded="false">
            <param name="arch" type="select" label="Recognition architecture" help="Usually detected from the model. Set explicitly only for models without architecture metadata.">
                <option value="auto" selected="true">Automatic</option>
                <option value="vgsl">VGSL</option>
                <option value="ppocrv6">PPOCRv6</option>
            </param>
            <param argument="--batch-size" type="integer" min="1" optional="true" label="Batch size" help="Leave empty to use Kraken's default."/>
            <param argument="--pad" type="integer" min="0" optional="true" label="Line padding" help="Padding in pixels at each end of a line. Leave empty to use Kraken's default."/>
            <param argument="--linetype" type="select" label="Line type">
                <option value="auto" selected="true">Automatic (model or dataset default)</option>
                <option value="baselines">Baselines</option>
                <option value="bbox">Bounding boxes</option>
            </param>
            <param argument="--normalization" type="select" label="Unicode normalization">
                <option value="None" selected="true">None</option>
                <option value="NFC">NFC</option>
                <option value="NFD">NFD</option>
                <option value="NFKC">NFKC</option>
                <option value="NFKD">NFKD</option>
            </param>
            <param name="normalize_whitespace" type="select" label="Normalize Unicode whitespace">
                <option value="auto" selected="true">Kraken default</option>
                <option value="--normalize-whitespace">Yes</option>
                <option value="--no-normalize-whitespace">No</option>
            </param>
            <conditional name="bidi">
                <param name="reorder" type="select" label="Bidirectional text reordering">
                    <option value="auto" selected="true">Kraken default</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                </param>
                <when value="auto"/>
                <when value="no"/>
                <when value="yes">
                    <param argument="--base-dir" type="select" label="Base text direction">
                        <option value="auto" selected="true">Use direction from input data</option>
                        <option value="L">Left-to-right</option>
                        <option value="R">Right-to-left</option>
                    </param>
                </when>
            </conditional>
            <param name="no_legacy_polygons" type="boolean" checked="false" truevalue="--no-legacy-polygons" falsevalue="" label="Disable legacy polygon extraction" help="By default, use the extraction method recorded in the model."/>
        </section>
    </inputs>
    <outputs>
        <data name="report" format="txt" label="${tool.name} on ${on_string}: recognition accuracy"/>
    </outputs>
